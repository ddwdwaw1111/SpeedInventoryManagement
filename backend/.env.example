APP_ENV=development
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=speed_inventory_management
DB_USER=inventory_user
DB_PASSWORD=inventory_pass

# Optional Cloudflare R2 attachment storage.
# Use either R2_ACCOUNT_ID + R2_BUCKET or a bucket-scoped R2_S3_API_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_S3_API_URL=
ATTACHMENT_MAX_UPLOAD_BYTES=26214400
