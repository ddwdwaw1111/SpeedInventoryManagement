{
  "name": "speed-inventory-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:portal": "vite --config vite.portal.config.ts",
    "build": "tsc && vite build",
    "build:portal": "tsc && vite build --config vite.portal.config.ts",
    "preview": "vite preview",
    "preview:portal": "vite preview --config vite.portal.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pdf": "tsc -p tsconfig.test.json && node ./tests/pdf-builders.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.17.14",
    "@types/pdfmake": "^0.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.17.0",
    "pdfmake": "^0.2.20",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.3",
    "react-resizable": "^3.1.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vitest": "^1.6.0"
  }
}
